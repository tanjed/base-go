            }
          }
        },
        "tags": [
          "HealthService"
        ]
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness: every dependency checked live. UNAVAILABLE (REST: 503) when any is down, so the\npod leaves rotation; the message names the failed components, never their errors (logged).",
